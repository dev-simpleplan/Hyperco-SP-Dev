{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="pf color-{{ section.settings.color_scheme }} gradient">
  <div class="pf-image">
    {%- if section.settings.image != blank -%}
      <img
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1100 }} 1100w"
        src="{{ section.settings.image | image_url: width: 1100 }}"
        sizes="(min-width: 750px) 40vw, 100vw"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {%- endif -%}
  </div>

  <div class="pf-panel">
    <div class="pf-panel__inner section-{{ section.id }}-padding">
      {%- if section.settings.logo != blank -%}
        <img class="pf-logo" src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" loading="lazy">
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.heading_colored != blank -%}
        <h2 class="pf-heading">{{ section.settings.heading }} <span>{{ section.settings.heading_colored }}</span></h2>
      {%- endif -%}

      {%- assign promo_form_id = 'PromoForm-' | append: section.id -%}
      {%- form 'contact', id: promo_form_id, class: 'pf-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="pf-form__message pf-form__message--success" tabindex="-1" autofocus>{{ section.settings.success_message | default: 'Thanks! We will be in touch shortly.' }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="pf-form__message pf-form__message--error" role="alert" tabindex="-1" autofocus>{{ 'templates.contact.form.error_heading' | t }}</p>
          {%- endif -%}

          <input type="hidden" name="contact[tags]" value="promo-form">

          {%- if section.settings.show_need_field and section.settings.need_options != blank -%}
            <div class="pf-field">
              <label for="PromoNeed-{{ section.id }}">{{ section.settings.need_label }}</label>
              <select id="PromoNeed-{{ section.id }}" name="contact[{{ section.settings.need_label }}]">
                {%- assign need_options = section.settings.need_options | split: ',' -%}
                {%- for option in need_options -%}
                  <option value="{{ option | strip }}">{{ option | strip }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          <div class="pf-row">
            <div class="pf-field">
              <label for="PromoFirstName-{{ section.id }}">First Name <span aria-hidden="true">*</span></label>
              <input type="text" id="PromoFirstName-{{ section.id }}" name="contact[First Name]" autocomplete="given-name" placeholder="First Name" required>
            </div>
            <div class="pf-field">
              <label for="PromoLastName-{{ section.id }}">Last Name <span aria-hidden="true">*</span></label>
              <input type="text" id="PromoLastName-{{ section.id }}" name="contact[Last Name]" autocomplete="family-name" placeholder="Last Name" required>
            </div>
          </div>

          <div class="pf-row">
            <div class="pf-field">
              <label for="PromoEmail-{{ section.id }}">Email <span aria-hidden="true">*</span></label>
              <input type="email" id="PromoEmail-{{ section.id }}" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="Email" required>
            </div>
            <div class="pf-field">
              <label for="PromoPhone-{{ section.id }}">Phone</label>
              <input type="tel" id="PromoPhone-{{ section.id }}" name="contact[Phone]" autocomplete="tel" pattern="[0-9\-]*" placeholder="Phone">
            </div>
          </div>

          <div class="pf-field">
            <label for="PromoMessage-{{ section.id }}">Message</label>
            <textarea id="PromoMessage-{{ section.id }}" name="contact[Body]" rows="4" placeholder="Write your message..">{{ form.body }}</textarea>
          </div>

          <button type="submit" class="button button--primary filled pf-submit">
            {{ section.settings.button_label }}
          </button>
        {%- endif -%}
      {%- endform -%}

      {%- if section.blocks.size > 0 -%}
        <div class="pf-app-block">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {% render block %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "10% off your "
    },
    {
      "type": "text",
      "id": "heading_colored",
      "label": "Heading (colored)",
      "default": "first team order"
    },
    {
      "type": "header",
      "content": "\"What do you need?\" field"
    },
    {
      "type": "checkbox",
      "id": "show_need_field",
      "label": "Show field",
      "default": true
    },
    {
      "type": "text",
      "id": "need_label",
      "label": "Field label",
      "default": "What do you need?"
    },
    {
      "type": "text",
      "id": "need_options",
      "label": "Options",
      "info": "Comma-separated list, e.g. Tracksuits, Jerseys, Uniforms",
      "default": "Tracksuits, Jerseys, Uniforms, Team gear"
    },
    {
      "type": "header",
      "content": "Submit button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Claim my 10% off"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks! We will be in touch shortly."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "t:sections.all.colors.accent_1.label" },
        { "value": "accent-2", "label": "t:sections.all.colors.accent_2.label" },
        { "value": "background-1", "label": "t:sections.all.colors.background_1.label" },
        { "value": "background-2", "label": "t:sections.all.colors.background_2.label" },
        { "value": "inverse", "label": "t:sections.all.colors.inverse.label" }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Promo form"
    }
  ]
}
{% endschema %}
