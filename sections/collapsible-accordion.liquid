{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="ccn page-width section-{{ section.id }}-padding">
    <div class="sp-heading center">
      {%- if section.settings.heading != blank or section.settings.heading_colored != blank -%}
        <h2>{{ section.settings.heading }} <span>{{ section.settings.heading_colored }}</span></h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="ccn-description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="ccn-grid" id="CcnGrid-{{ section.id }}">
      <div class="ccn-image">
        {%- for block in section.blocks -%}
          <div class="ccn-image-item{% if forloop.first %} active{% endif %}" data-ccn-image="{{ block.id }}">
            {%- if block.settings.image != blank -%}
              <img
                srcset="{{ block.settings.image | image_url: width: 550 }} 550w, {{ block.settings.image | image_url: width: 1100 }} 1100w"
                src="{{ block.settings.image | image_url: width: 1100 }}"
                sizes="(min-width: 750px) 50vw, 100vw"
                alt="{{ block.settings.image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="ccn-accordion">
        {%- for block in section.blocks -%}
          <div class="ccn-accordion-item{% if forloop.first %} active{% endif %}" data-ccn-accordion="{{ block.id }}" {{ block.shopify_attributes }}>
            <button type="button" class="ccn-accordion-item__summary" id="CcnSummary-{{ block.id }}-{{ section.id }}" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="CcnContent-{{ block.id }}-{{ section.id }}">
              <span class="ccn-accordion-item__icon-title">
                {%- if block.settings.icon != blank -%}
                  <span class="ccn-accordion-item__icon">
                    <img src="{{ block.settings.icon | image_url: width: 64 }}" alt="" loading="lazy" width="32" height="32">
                  </span>
                {%- endif -%}
                <span class="ccn-accordion-item__title">{{ block.settings.heading }}</span>
              </span>
              {% render 'icon-caret' %}
            </button>
            <div class="ccn-accordion-item__panel" id="CcnContent-{{ block.id }}-{{ section.id }}" role="region" aria-labelledby="CcnSummary-{{ block.id }}-{{ section.id }}">
              <div class="ccn-accordion-item__content rte">
                {{ block.settings.row_content }}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var grid = document.getElementById('CcnGrid-{{ section.id }}');
    if (!grid) return;

    var items = grid.querySelectorAll('.ccn-accordion-item');

    function panelOf(item) {
      return item.querySelector('.ccn-accordion-item__panel');
    }

    function openPanel(item) {
      var panel = panelOf(item);
      panel.style.maxHeight = panel.scrollHeight + 'px';
    }

    function closePanel(item) {
      var panel = panelOf(item);
      panel.style.maxHeight = panel.scrollHeight + 'px';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          panel.style.maxHeight = '0px';
        });
      });
    }

    function setActive(target) {
      var blockId = target.getAttribute('data-ccn-accordion');

      items.forEach(function (item) {
        var isActive = item === target;
        item.classList.toggle('active', isActive);
        item.querySelector('.ccn-accordion-item__summary').setAttribute('aria-expanded', isActive);
        if (isActive) {
          openPanel(item);
        } else {
          closePanel(item);
        }
      });

      grid.querySelectorAll('.ccn-image-item').forEach(function (imageItem) {
        imageItem.classList.toggle('active', imageItem.getAttribute('data-ccn-image') === blockId);
      });
    }

    items.forEach(function (item) {
      var panel = panelOf(item);
      panel.style.maxHeight = item.classList.contains('active') ? panel.scrollHeight + 'px' : '0px';

      item.querySelector('.ccn-accordion-item__summary').addEventListener('click', function () {
        if (item.classList.contains('active')) return;
        setActive(item);
      });
    });

    window.addEventListener('resize', function () {
      items.forEach(function (item) {
        if (!item.classList.contains('active')) return;
        var panel = panelOf(item);
        panel.style.maxHeight = panel.scrollHeight + 'px';
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collapsible Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for teams "
    },
    {
      "type": "text",
      "id": "heading_colored",
      "label": "Heading (colored)",
      "default": "that expect more"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Premium isn't a claim, it's in the stitching. Every jersey is built on pro-weight fabric, full sublimation, and construction details that hold up season after season, collar to cuff.</p>"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "inverse",
          "label": "t:sections.all.colors.inverse.label"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collapsible_row",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Collapsible row",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "row_content",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown when this row is expanded"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Collapsible Accordion",
      "blocks": [
        {
          "type": "collapsible_row"
        },
        {
          "type": "collapsible_row"
        },
        {
          "type": "collapsible_row"
        },
        {
          "type": "collapsible_row"
        }
      ]
    }
  ]
}
{% endschema %}
